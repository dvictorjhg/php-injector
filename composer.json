{
    "name": "dvictorjhg/php-injector",
    "type": "library",
    "description": "Reflection-based dependency injection and PSR-11 container for modern PHP.",
    "keywords": [
        "dependency-injection",
        "container",
        "injector",
        "php",
        "psr-11",
        "reflection"
    ],
    "license": "Apache-2.0",
    "homepage": "https://github.com/dvictorjhg/php-injector",
    "authors": [
        {
            "name": "Victor Jose Holgado Gallegos",
            "email": "vihoga@hotmail.es",
            "homepage": "https://github.com/dvictorjhg",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/dvictorjhg/php-injector/issues",
        "source": "https://github.com/dvictorjhg/php-injector",
        "docs": "https://github.com/dvictorjhg/php-injector/tree/main/docs"
    },
    "require": {
        "php": "^8.4",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "provide": {
        "psr/container-implementation": "2.0.2"
    },
    "autoload": {
        "psr-4": {
            "PHPInjector\\": "src/"
        },
        "files": [
            "src/DI/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PHPInjector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit",
        "test:coverage": [
            "@php -r \"is_dir('build/test-results') || mkdir('build/test-results', 0777, true);\"",
            "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-clover build/test-results/clover.xml --coverage-html build/test-results/coverage-html"
        ],
        "coverage:check": "@php tools/check-coverage.php build/test-results/clover.xml 80"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
